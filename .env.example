# Application
PORT=3000
NODE_ENV=development
APP_NAME=dailzo
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://dailzo:dailzo@localhost:5432/dailzo
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_BUCKET=dailzo-dev
AWS_SQS_QUEUE_URL=http://localhost:4566/000000000000/dailzo-queue

# Firebase
FIREBASE_PROJECT_ID=replace-me
FIREBASE_CLIENT_EMAIL=replace-me
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# Payments
RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me
