# Dailzo — local infrastructure
#
# The backend API + admin panel now live in ./server (Laravel + Filament) and
# keep their own ./server/.env. This file only documents the shared local
# database used by docker-compose.yml.
#
# The legacy NestJS app in ./backend is frozen and being removed at cutover
# (see docs/php-migration-plan.md).

# Database (MySQL) — matches docker-compose.yml, exposed on host port 3307
MYSQL_DATABASE=dailzo
MYSQL_USER=dailzo
MYSQL_PASSWORD=dailzo
MYSQL_ROOT_PASSWORD=dailzo
