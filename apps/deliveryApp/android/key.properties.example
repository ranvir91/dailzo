# Copy this file to android/key.properties (gitignored) and fill in the
# values from the upload keystore you generate for this app. Never commit the
# real key.properties or the .jks file — losing this keystore means you can
# never update the app under the same Play Store listing again.
#
# This should be a SEPARATE keystore from the one used for apps/mobile —
# each Android app package gets its own signing identity.
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/absolute/path/to/dailzo-partner-upload-keystore.jks
