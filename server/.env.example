APP_NAME=Dailzo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL / MariaDB) ---
# Defaults match docker-compose.yml (host port 3307). For an existing local
# MySQL use DB_PORT=3306 and your own credentials.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=dailzo
DB_USERNAME=dailzo
DB_PASSWORD=dailzo

# File drivers everywhere — no Redis, no queue workers (shared hosting).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=uploads
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

# OTP delivery. While OTP_DEBUG=true the generated OTP is returned in the
# /auth/send-otp response body (dev only, matches the old backend behaviour).
OTP_DEBUG=true
OTP_TTL_SECONDS=300

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@dailzo.app"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
